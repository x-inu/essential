#!/bin/sh

set -e

FILE="/etc/cloud/cloud.cfg.d/99-disable-network-config.cfg"

if [ "$(id -u)" -eq 0 ]; then
    SUDO=""
else
    if ! command -v sudo >/dev/null 2>&1; then
        echo "sudo tidak ditemukan. Jalankan script sebagai root."
        exit 1
    fi

    echo "Meminta akses sudo..."
    sudo -v
    SUDO="sudo"
fi

$SUDO mkdir -p /etc/cloud/cloud.cfg.d

echo 'network: {config: disabled}' | $SUDO tee "$FILE" >/dev/null

echo "Berhasil membuat:"
echo "$FILE"
echo ""
$SUDO cat "$FILE"
