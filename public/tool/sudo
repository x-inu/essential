#!/bin/sh

set -eu

# =========================================================
# Install sudo & grant sudo access
# Support: Debian / Ubuntu
# =========================================================

if [ "$(id -u)" -ne 0 ]; then
    echo "Error: script harus dijalankan sebagai root."
    echo "Gunakan:"
    echo "  curl -fsSL URL_SCRIPT | sudo sh"
    exit 1
fi

# Tentukan user
if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    TARGET_USER="$SUDO_USER"
elif [ -n "${USER_TO_SUDO:-}" ]; then
    TARGET_USER="$USER_TO_SUDO"
else
    TARGET_USER="$(logname 2>/dev/null || true)"
fi

# Pastikan target user ditemukan
if [ -z "${TARGET_USER:-}" ] || [ "$TARGET_USER" = "root" ]; then
    echo "Error: user target tidak dapat dideteksi."
    echo
    echo "Jalankan dengan:"
    echo "  USER_TO_SUDO=namauser curl -fsSL URL_SCRIPT | sh"
    echo
    echo "atau:"
    echo "  curl -fsSL URL_SCRIPT | USER_TO_SUDO=namauser sh"
    exit 1
fi

# Pastikan user memang ada
if ! id "$TARGET_USER" >/dev/null 2>&1; then
    echo "Error: user '$TARGET_USER' tidak ditemukan."
    exit 1
fi

echo "User target : $TARGET_USER"

# Install sudo jika belum tersedia
if ! command -v sudo >/dev/null 2>&1; then
    echo "Menginstall sudo..."

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y sudo
else
    echo "sudo sudah terinstall."
fi

# Tambahkan user ke group sudo
if id -nG "$TARGET_USER" | tr ' ' '\n' | grep -qx sudo; then
    echo "$TARGET_USER sudah berada di group sudo."
else
    echo "Menambahkan $TARGET_USER ke group sudo..."
    usermod -aG sudo "$TARGET_USER"
fi

# Buat konfigurasi sudoers khusus user
SUDOERS_FILE="/etc/sudoers.d/$TARGET_USER"

echo "$TARGET_USER ALL=(ALL:ALL) ALL" > "$SUDOERS_FILE"

chmod 440 "$SUDOERS_FILE"

# Validasi konfigurasi sudoers
if visudo -cf "$SUDOERS_FILE" >/dev/null 2>&1; then
    echo "Konfigurasi sudoers valid."
else
    echo "Error: konfigurasi sudoers tidak valid."
    rm -f "$SUDOERS_FILE"
    exit 1
fi

echo
echo "========================================="
echo " SUDO BERHASIL DIKONFIGURASI"
echo "========================================="
echo "User : $TARGET_USER"
echo "Group: sudo"
echo
echo "Login ulang agar group sudo aktif."
echo
echo "Test:"
echo "  sudo whoami"
echo
echo "Output seharusnya:"
echo "  root"
